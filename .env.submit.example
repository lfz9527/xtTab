# wxt submit 商店凭证模板
# 复制为 .env.submit 并填入真实值；.env.submit 已被 .gitignore 排除，禁止提交入库
# 各凭证获取位置详见 xttab-release skill（.agents/skills/xttab-release/SKILL.md 发版前确认）

# ===== Chrome Web Store（默认发版目标）=====
# 扩展 ID：CWS 开发者后台扩展详情页 URL 中 item?id= 后的一串
CHROME_EXTENSION_ID=""
# Client ID / Secret：Google Cloud → APIs & Services → Credentials → OAuth client ID（类型选 Desktop app）
CHROME_CLIENT_ID=""
CHROME_CLIENT_SECRET=""
# Refresh Token：由 Client ID/Secret 配合授权码换取（wxt submit init 可交互引导获取）
CHROME_REFRESH_TOKEN=""

# ===== Edge Add-ons（默认发版目标）=====
# Product ID：Partner Center → Microsoft Edge → Overview → 扩展详情页
EDGE_PRODUCT_ID=""
# Client ID / API Key：Partner Center → Microsoft Edge → Publish API → Create API credentials 生成
EDGE_CLIENT_ID=""
EDGE_API_KEY=""

# ===== Firefox Add-ons（仅在发 Firefox 时配置）=====
# 扩展 ID：AMO 扩展详情页底部
FIREFOX_EXTENSION_ID=""
# JWT Issuer / Secret：https://addons.mozilla.org/developers/addon/api/key/
FIREFOX_JWT_ISSUER=""
FIREFOX_JWT_SECRET=""
